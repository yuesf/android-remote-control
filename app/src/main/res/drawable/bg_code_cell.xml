<?xml version="1.0" encoding="utf-8"?>
<!-- 配对码分段格：空态 surfaceVariant + 1.5dp 描边；聚焦 2dp 主色 + primaryContainer 底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary_container" />
            <stroke android:width="2dp" android:color="@color/md_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_variant" />
            <stroke android:width="1.5dp" android:color="@color/md_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
