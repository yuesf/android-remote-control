<?xml version="1.0" encoding="utf-8"?>
<!--
    浮在远端画面上方的控制条。做成圆角胶囊而不是通栏：
    通栏会连远方屏幕底部一起盖住，远端自己的导航按键就点不到了。
    半透明 sess 色，既保证按钮可读，又不把画面整块盖死。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/sess_controlbar_scrim" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/sess_controlbar_stroke" />
</shape>
