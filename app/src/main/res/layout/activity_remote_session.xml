<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sessionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeSessionButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close_session"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/sessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_session_connecting"
            android:textColor="#D7E8FA"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
        控制条不做通栏贴底：贴底会盖住远端屏幕自己的导航按键（三键 / 手势条），
        用户想按远端的返回键反而按到了我们的按钮。抬高 96dp 并留出左右边距，
        以胶囊形式浮在画面上，远端底部区域始终露着。
    -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_control_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control_back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control_home"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recentsButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control_recents"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!--
        控制栏隐藏后唯一的操作入口：连通时全屏都是远端画面，
        没有把手用户就再也唤不出「返回 / 主页 / 关闭」，只能杀掉进程。
        做成小胶囊：深色半透明底 + 白字，浅色深色画面上都看得见。
    -->
    <TextView
        android:id="@+id/controlsHandle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_controls_handle"
        android:contentDescription="@string/controls_handle_desc"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/controls_handle_label"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
