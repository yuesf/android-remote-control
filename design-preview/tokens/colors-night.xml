<?xml version="1.0" encoding="utf-8"?>
<!--
  信号台 SIGNAL DECK · 深色 token
  放置位置：app/src/main/res/values-night/colors.xml
  与 values/colors.xml 严格同名不同值；sess_* 会话常量不在此重复定义。

  精确值已由视觉侧确认（原派生值已替换）：
    md_secondary            = #A9B9BE （比 onSurfaceVariant #A3B3B8 略亮一档，拉开中强调层级）
    md_on_secondary         = #1B282C
    md_secondary_container  = #2A3B40 （比 surfaceVariant #232E31 再亮一档）
    md_on_secondary_container = #C4D5D9
    sem_connecting          = #4ED3D6 （= 深色 primary，派生正确，保持不变）
    sem_connecting_bg       = #14434A （= 深色 primaryContainer）
    sem_connecting_on       = #C9F4F5 （= 深色 onPrimaryContainer）
  被控常驻条深色：底 sem_controlled_bg #3A1E12 / 字 sem_controlled_bar_on #FFB287 / 点 sem_controlled #FF9159。

  使用边界：md_secondary* 只用于中强调文字与图标，不得承载任何状态语义；
  状态一律走 sem_*。占位「–」的 40% 透明度基于 onSurfaceVariant，不是 secondary。
-->
<resources>
    <!-- ========== 基础 Material 色（md_*） ========== -->
    <color name="md_primary">#4ED3D6</color>
    <color name="md_on_primary">#052A2E</color>
    <color name="md_primary_container">#14434A</color>
    <color name="md_on_primary_container">#C9F4F5</color>
    <color name="md_secondary">#A9B9BE</color>
    <color name="md_on_secondary">#1B282C</color>
    <color name="md_secondary_container">#2A3B40</color>
    <color name="md_on_secondary_container">#C4D5D9</color>
    <color name="md_surface">#151D20</color>
    <color name="md_background">#0E1416</color>
    <color name="md_on_surface">#E9F0F1</color>
    <color name="md_surface_variant">#232E31</color>
    <color name="md_on_surface_variant">#A3B3B8</color>
    <color name="md_outline">#3B4B50</color>
    <color name="md_outline_variant">#293439</color>
    <color name="md_error">#FF8A80</color>
    <color name="md_error_container">#5F1D17</color>

    <!-- ========== 语义状态色（sem_*，深色） ========== -->
    <color name="sem_online">#5BE0A5</color>
    <color name="sem_online_bg">#17342B</color>
    <color name="sem_connecting">#4ED3D6</color>
    <color name="sem_connecting_bg">#14434A</color>
    <color name="sem_connecting_on">#C9F4F5</color>
    <color name="sem_offline">#8A9A9F</color>
    <color name="sem_offline_bg">#232E31</color>
    <color name="sem_lost">#FF8A80</color>
    <color name="sem_lost_bg">#5F1D17</color>
    <color name="sem_controlled">#FF9159</color>
    <color name="sem_controlled_bg">#3A1E12</color>
    <color name="sem_controlled_bar_on">#FFB287</color>
</resources>
