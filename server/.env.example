PORT=8787
BIND_HOST=0.0.0.0
AUTH_TOKEN=replace-with-at-least-16-random-characters
MAX_WS_PAYLOAD_BYTES=262144
LOG_LEVEL=info

# ICE servers handed to both phones in the ready message.
# STUN only discovers the public mapping; a symmetric NAT still needs TURN relaying.
# Use the public IP of the machine running coturn, never 127.0.0.1 or a LAN address.
STUN_URLS=stun:203.0.113.10:3478
TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_USERNAME=replace-with-turn-user
TURN_CREDENTIAL=replace-with-turn-password
